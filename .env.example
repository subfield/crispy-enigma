NODE_ENV=development
PORT=4100

# Must match the Smink auth app and dashboard exactly.
JWT_SECRET=

# Postgres. The game server owns every smink_* table.
CONNECTION_MODE=local
DATABASE_URL_LOCAL=postgresql://user:password@localhost:5432/database
DATABASE_URL_NEON=

# Redis. Port 6380 locally to avoid clashing with mailNw on 6379.
REDIS_URL=redis://localhost:6380

# RabbitMQ, for post-commit event fan-out only.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=smink.events

# Ably. The API key stays server-side; browsers get scoped tokens
# from POST /v1/realtime/token.
ABLY_API_KEY=

# Browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:5642,http://localhost:5641

# The worker watches pending deposits on public explorers and auto-credits
# when the quoted crypto amount confirms. Odd or high-risk payments stay
# in review for the admin cash desk.

# Mailer. Used after auto-credit so the player gets a deposit email.
# Same values as frontend/admin and frontend/smink.
MAILER_BASE_URL=https://mailer.oraixo.org
MAILER_API_KEY=
SMINK_DASHBOARD_URL=http://localhost:5642
